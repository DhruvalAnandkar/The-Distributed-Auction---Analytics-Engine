{
    "name": "distributed-auction-engine-root",
    "version": "1.0.0",
    "description": "Distributed Auction Engine Root",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "api-dev": "npm run dev --workspace=apps/api",
        "api:dev": "npm run dev --workspace=apps/api",
        "test": "npm test --workspace=apps/api && npm run test:agent",
        "test:agent": "node --test \"scripts/agent/**/*.test.mjs\"",
        "agent": "node scripts/agent/run.mjs"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1"
    },
    "engines": {
        "node": ">=22"
    }
}
